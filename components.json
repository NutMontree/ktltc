{
  "$schema": "https://ui.shadcn.com/schema.json",
  "style": "default",
  "rsc": true,
  "tsx": true,
  "tailwind": {
    "config": "tailwind.config.ts",
    "css": "src/app/globals.css",
    "baseColor": "slate",
    "cssVariables": true,
    "prefix": ""
  },
  "aliases": {
    "components": "@/components",
    "utils": "@/lib/utils",
    "ui": "@/components/ui"
  },
  "iconLibrary": "lucide",
  "registries": [
    {
      "name": "reactbits-starter",
      "type": "registry:ui",
      "url": "https://api.reactbits.dev/v1/registry/starter"
    },
    {
      "name": "reactbits-pro",
      "type": "registry:ui",
      "url": "https://api.reactbits.dev/v1/registry/pro",
      "headers": {
        "Authorization": "Bearer $REACTBITS_LICENSE_KEY"
      }
    }
  ]
}
